{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ec528-fall26/zero-trust/blob/main/src/request_schema.json",
  "title": "Nono workload request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "operation",
    "target",
    "input_name",
    "expected_input_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "ec528.nono.request.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "operation": {
      "const": "checksum.sha256"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "input_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "expected_input_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
